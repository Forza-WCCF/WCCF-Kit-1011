# Made on a player's PC by the kit: settings, keys, logs, the club cards, and data\cache\ (the catalogue and card
# pictures SETUP.exe makes from the player's own game files) - never commit a save.
/data/

# Built from source\ by source\build.ps1 (and by CI into the kit ZIP) - git holds the source, not the programs.
/PLAY.exe
/SETUP.exe
/ENGLISH.exe
/version.txt
/files.txt
/programs/
/source/build/
/source/launcher/target/
/dist/

# Python's caches (a script run from a checkout).
__pycache__/
